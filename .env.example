# Copy to .env.local for development. Nothing here is a secret until you fill it in; .env*.local is not committed.

# Public address of the site (canonical URLs, sitemap, and the origin the lead form accepts).
# Set it explicitly for Production. On Vercel previews leave it unset: the build uses its own VERCEL_BRANCH_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Crawlers are blocked (robots.txt Disallow: /) unless this is "true". Set it for Production at cutover only.
# SITE_INDEXABLE=true

# Email gate. Off unless this is "true" at BUILD time, because the page is prerendered with it.
LEAD_CAPTURE_ENABLED=false

# Where leads are kept. DATABASE_URL (the Neon connection string, added by the Vercel integration; `vercel env pull`)
# selects the database store. "file" writes .data/leads.json and is for local development and tests only.
# With neither, the route answers 503.
# DATABASE_URL=
LEAD_STORE=file
# LEAD_STORE_PATH=.data/leads.json

# Required in production: a long random string, used to hash visitor addresses for the rate limit.
# LEAD_IP_SALT=
# Extra origins allowed to post to /api/lead (comma separated), for example a preview URL
# LEAD_ALLOWED_ORIGINS=

# Follow-up email, development: run `mailpit` and open http://localhost:8025
MAILPIT_URL=http://localhost:8025
# Follow-up email, production: SendGrid. All three are needed or no email is sent.
# SENDGRID_API_KEY=
# LEAD_FROM_EMAIL=
# LEAD_MAILING_ADDRESS=
# LEAD_FROM_NAME=
# LEAD_REPLY_TO=

# Reading-plan coach pages (/plan, /review). Off until cutover; read at BUILD time, so a change needs a redeploy.
NEXT_PUBLIC_COACH_ENABLED=false

# Testing a deployment: PLAYWRIGHT_BASE_URL=https://<preview>.vercel.app pnpm e2e
# Previews are behind Vercel login; also set the project's "Protection Bypass for Automation" secret.
# VERCEL_AUTOMATION_BYPASS_SECRET=
