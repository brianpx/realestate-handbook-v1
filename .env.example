# Copy to .env.local for development. Nothing here is a secret until you fill it in; .env*.local is not committed.

# Public address of the site (canonical URLs, sitemap, and the origin the lead form accepts).
# Set it explicitly for Production. On Vercel previews leave it unset: the build uses its own VERCEL_BRANCH_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Crawlers are blocked (robots.txt Disallow: /) unless this is "true". Set it for Production at cutover only.
# SITE_INDEXABLE=true

# LEAD_CAPTURE_ENABLED is no longer read: the first-visit dialog it switched on is gone (M5), and the forms post
# whenever a store is configured below.

# Where leads are kept. DATABASE_URL (the Neon connection string, added by the Vercel integration; `vercel env pull`)
# selects the database store. "file" writes .data/leads.json and is for local development and tests only; a hosted
# Vercel deployment (production or preview) ignores it. With neither, the route answers 503.
# DATABASE_URL=
# LEAD_STORE=file
# LEAD_STORE_PATH=.data/leads.json

# Required in production: a long random string, used to hash visitor addresses for the rate limit.
# LEAD_IP_SALT=
# Extra origins allowed to post to /api/lead (comma separated), for example a preview URL
# LEAD_ALLOWED_ORIGINS=

# Follow-up email, development: run `mailpit` and open http://localhost:8025
MAILPIT_URL=http://localhost:8025
# Follow-up email, production: SendGrid. All three are needed or no email is sent.
# SENDGRID_API_KEY=
# LEAD_FROM_EMAIL=
# LEAD_MAILING_ADDRESS=
# LEAD_FROM_NAME=
# LEAD_REPLY_TO=
# Cost backstop (M8): at most this many confirmation emails and, separately, sign-in emails per ten minutes over all
# callers. A positive whole number; unset or anything else is the default of 60.
# EMAIL_SEND_CEILING=60

# Accounts and sign-in (M5). Where users, sign-in tokens and sessions are kept: DATABASE_URL selects the database;
# "file" writes .data/auth.json and is for local development and tests only (a hosted deployment ignores it).
# With neither, the sign-in routes answer 503 and the handbook cannot be opened.
# AUTH_STORE=file
# AUTH_STORE_PATH=.data/auth.json
# Salt for the sign-in rate limits; LEAD_IP_SALT is used when this is unset.
# AUTH_IP_SALT=
# Comma-separated addresses that become the first administrator on sign-in, only while no administrator exists.
# ADMIN_BOOTSTRAP_EMAILS=
# Billing and the reconcile cron (M7); nothing reads these yet.
# BILLING_PROVIDER=
# BILLING_WEBHOOK_SECRET=
# BILLING_API_KEY=
# CRON_SECRET=

# Reading-plan coach pages (/plan, /review). Off until cutover; read at BUILD time, so a change needs a redeploy.
NEXT_PUBLIC_COACH_ENABLED=false

# Testing a deployment: PLAYWRIGHT_BASE_URL=https://<preview>.vercel.app pnpm e2e
# Previews are behind Vercel login; also set the project's "Protection Bypass for Automation" secret.
# VERCEL_AUTOMATION_BYPASS_SECRET=
